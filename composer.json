{
    "name": "quebecstudio-mods/consent-kit-register",
    "description": "Consent register shared by the Cookie Consent Kit CMS integrations: schema, storage and queries.",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "consent",
        "cookies",
        "loi25",
        "gdpr"
    ],
    "authors": [
        {
            "name": "Québec Studio",
            "homepage": "https://quebecstudio.com"
        }
    ],
    "require": {
        "php": ">=8.2",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "quebecstudio-mods/consent-kit-core": "^1.2"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-laravel": "^3.0 || ^4.0 || ^5.0",
        "pestphp/pest-plugin-type-coverage": "^3.0",
        "phpstan/phpstan": "^2.2",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "QuebecStudioMods\\ConsentKit\\Register\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "QuebecStudioMods\\ConsentKit\\Register\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "@php vendor/bin/pest",
        "style": "@php vendor/bin/pint --test",
        "stan": "@php -d memory_limit=512M vendor/bin/phpstan analyse --no-progress",
        "types": "@php -d memory_limit=512M vendor/bin/pest --type-coverage --compact --min=100",
        "check": [
            "@style",
            "@stan",
            "@types",
            "@test"
        ],
        "refactor": "@php -d memory_limit=512M vendor/bin/rector process --dry-run"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
